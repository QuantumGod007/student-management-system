# ---------------------------------------------------------------
# Server configuration - copy this file to server/.env
# Never commit the real .env file.
# ---------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas for deployment)
# Local example:  mongodb://127.0.0.1:27017/student_management
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/student_management?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/student_management

# Port assigned by the host (Render sets this automatically)
PORT=5001

# development | production
NODE_ENV=development

# Comma separated list of allowed browser origins.
# Local:      http://localhost:5173
# Production: https://your-frontend.onrender.com
# Leave empty to allow every origin (development only).
CLIENT_ORIGIN=http://localhost:5173
