# ---------------------------------------------------------------
# Frontend configuration - copy this file to client/.env
# Only VITE_ prefixed variables are exposed to the browser.
# ---------------------------------------------------------------

# Development: leave empty and Vite proxies /api to http://localhost:5001.
# Production: full public API base URL including the /api prefix.
# VITE_API_URL=https://your-api-service.onrender.com/api
VITE_API_URL=
