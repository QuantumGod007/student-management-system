{
  "info": {
    "_postman_id": "b7e4c1a2-5f3d-4a91-9c62-0a7d5e9f1c33",
    "name": "MITAOE_Practical_06_Student_Management_API",
    "description": "MITAOE Web Technology Practical No. 06 - Student Management REST API.\n\nRun the requests in order. The collection creates its own test student using a unique Student ID and email, verifies CRUD behaviour, then deletes the temporary records so the database is left clean.\n\nSelect an environment:\n- LOCAL: http://localhost:5001/api\n- DEPLOYED: set baseUrl to your public API URL (for example https://your-api.onrender.com/api).\n\nEvery request uses the `baseUrl` variable, so the same collection works locally and against the deployed API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api",
      "type": "string"
    },
    {
      "key": "studentObjectId",
      "value": "",
      "type": "string"
    },
    {
      "key": "testStudentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "baselineStudentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "baselineEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "baselineObjectId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. API Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test(\"API reports ok\", () => pm.expect(body.status).to.eql(\"ok\"));",
              "pm.test(\"Database is connected\", () => pm.expect(body.database).to.eql(\"connected\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Create Student (POST)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Unique values for every run so the tests never hit stale data.",
              "const unique = String(Date.now()).slice(-9);",
              "",
              "pm.collectionVariables.set(\"testStudentId\", `PM${unique}`);",
              "pm.collectionVariables.set(\"testEmail\", `pm${unique}@mitaoe.ac.in`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 (Created)\", () => pm.response.to.have.status(201));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test(\"Response contains success flag and message\", () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.message).to.eql(\"Student created successfully\");",
              "});",
              "",
              "pm.test(\"Created student has a MongoDB id\", () => {",
              "  pm.expect(body.data).to.have.property(\"_id\").that.is.a(\"string\");",
              "});",
              "",
              "pm.test(\"Student fields match the request\", () => {",
              "  pm.expect(body.data.studentId).to.eql(pm.collectionVariables.get(\"testStudentId\"));",
              "  pm.expect(body.data.name).to.eql(\"Aarav Patil\");",
              "  pm.expect(body.data.email).to.eql(pm.collectionVariables.get(\"testEmail\"));",
              "  pm.expect(body.data.phone).to.eql(\"9876543210\");",
              "  pm.expect(body.data.department).to.eql(\"CSE\");",
              "  pm.expect(body.data.year).to.eql(3);",
              "  pm.expect(body.data.division).to.eql(\"A\");",
              "});",
              "",
              "pm.test(\"createdAt and updatedAt timestamps exist\", () => {",
              "  pm.expect(body.data).to.have.property(\"createdAt\");",
              "  pm.expect(body.data).to.have.property(\"updatedAt\");",
              "});",
              "",
              "// Save the id for the GET, PUT and DELETE requests.",
              "pm.collectionVariables.set(\"studentObjectId\", body.data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"{{testStudentId}}\",\n  \"name\": \"Aarav Patil\",\n  \"email\": \"{{testEmail}}\",\n  \"phone\": \"9876543210\",\n  \"department\": \"CSE\",\n  \"year\": 3,\n  \"division\": \"A\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        }
      }
    },
    {
      "name": "2. Get All Students (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 (OK)\", () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test(\"Response returns an array of students\", () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data).to.be.an(\"array\");",
              "  pm.expect(body.count).to.eql(body.data.length);",
              "});",
              "",
              "pm.test(\"List is not empty\", () => pm.expect(body.data.length).to.be.above(0));",
              "",
              "pm.test(\"Created student is present in the list\", () => {",
              "  const id = pm.collectionVariables.get(\"studentObjectId\");",
              "  pm.expect(body.data.some((student) => student._id === id)).to.eql(true);",
              "});",
              "",
              "pm.test(\"Every student exposes the documented fields\", () => {",
              "  const fields = [\"studentId\", \"name\", \"email\", \"phone\", \"department\", \"year\", \"division\", \"createdAt\", \"updatedAt\"];",
              "  body.data.forEach((student) => {",
              "    fields.forEach((field) => pm.expect(student).to.have.property(field));",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        }
      }
    },
    {
      "name": "3. Get Student by ID (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 (OK)\", () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test(\"Returns the requested student\", () => {",
              "  pm.expect(body.data._id).to.eql(pm.collectionVariables.get(\"studentObjectId\"));",
              "  pm.expect(body.data.studentId).to.eql(pm.collectionVariables.get(\"testStudentId\"));",
              "});",
              "",
              "pm.test(\"Email matches the created record\", () => {",
              "  pm.expect(body.data.email).to.eql(pm.collectionVariables.get(\"testEmail\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/students/{{studentObjectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["students", "{{studentObjectId}}"]
        }
      }
    },
    {
      "name": "4. Update Student (PUT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 (OK)\", () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test(\"Response reports the update\", () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.message).to.eql(\"Student updated successfully\");",
              "});",
              "",
              "pm.test(\"Updated values are returned\", () => {",
              "  pm.expect(body.data.name).to.eql(\"Aarav S Patil\");",
              "  pm.expect(body.data.phone).to.eql(\"9876501234\");",
              "  pm.expect(body.data.department).to.eql(\"IT\");",
              "  pm.expect(body.data.year).to.eql(4);",
              "  pm.expect(body.data.division).to.eql(\"B\");",
              "});",
              "",
              "pm.test(\"The same document was updated\", () => {",
              "  pm.expect(body.data._id).to.eql(pm.collectionVariables.get(\"studentObjectId\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"{{testStudentId}}\",\n  \"name\": \"Aarav S Patil\",\n  \"email\": \"{{testEmail}}\",\n  \"phone\": \"9876501234\",\n  \"department\": \"IT\",\n  \"year\": 4,\n  \"division\": \"B\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students/{{studentObjectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["students", "{{studentObjectId}}"]
        }
      }
    },
    {
      "name": "5. Delete Student (DELETE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 (OK)\", () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test(\"Response confirms the deletion\", () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.message).to.eql(\"Student deleted successfully\");",
              "});",
              "",
              "pm.test(\"Deleted document is returned\", () => {",
              "  pm.expect(body.data._id).to.eql(pm.collectionVariables.get(\"studentObjectId\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/students/{{studentObjectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["students", "{{studentObjectId}}"]
        }
      }
    },
    {
      "name": "6. Verify Deleted Student Returns 404 (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 404 (Not Found)\", () => pm.response.to.have.status(404));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test(\"Error response is descriptive\", () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.include(\"not found\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/students/{{studentObjectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["students", "{{studentObjectId}}"]
        }
      }
    },
    {
      "name": "7. Verify Invalid Input Handling (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400 (Bad Request)\", () => pm.response.to.have.status(400));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test(\"Invalid data is rejected with field level errors\", () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.eql(\"Validation failed\");",
              "  pm.expect(body.errors).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "",
              "pm.test(\"Invalid email and missing fields are reported\", () => {",
              "  const fields = body.errors.map((error) => error.field);",
              "  pm.expect(fields).to.include(\"email\");",
              "  pm.expect(fields).to.not.include(\"studentId\");",
              "  pm.expect(body.errors.find((error) => error.field === \"email\").message).to.include(\"invalid\");",
              "});",
              "",
              "pm.test(\"Invalid student is not created\", () => {",
              "  pm.sendRequest(",
              "    {",
              "      url: `${pm.variables.get(\"baseUrl\")}/students?search=BAD-INPUT-01`,",
              "      method: \"GET\",",
              "    },",
              "    (error, response) => {",
              "      pm.expect(error).to.be.null;",
              "      pm.expect(response.json().count).to.eql(0);",
              "    }",
              "  );",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"BAD-INPUT-01\",\n  \"name\": \"Invalid Email\",\n  \"email\": \"not-an-email\",\n  \"phone\": \"12345\",\n  \"department\": \"CSE\",\n  \"year\": 3,\n  \"division\": \"A\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        }
      }
    },
    {
      "name": "8a. Setup Student for Duplicate Email Test (POST)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const unique = String(Date.now()).slice(-9);",
              "",
              "pm.collectionVariables.set(\"baselineStudentId\", `DUP${unique}`);",
              "pm.collectionVariables.set(\"baselineEmail\", `duplicate${unique}@mitaoe.ac.in`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Baseline student is created\", () => pm.response.to.have.status(201));",
              "",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"baselineObjectId\", body.data._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"{{baselineStudentId}}\",\n  \"name\": \"Duplicate Baseline\",\n  \"email\": \"{{baselineEmail}}\",\n  \"phone\": \"9876500001\",\n  \"department\": \"ECE\",\n  \"year\": 2,\n  \"division\": \"C\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        }
      }
    },
    {
      "name": "8b. Verify Duplicate Email Handling (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400 (Bad Request)\", () => pm.response.to.have.status(400));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test(\"Duplicate email is rejected with a clear message\", () => {",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.message).to.include(\"already exists\");",
              "  pm.expect(body.errors[0].field).to.eql(\"email\");",
              "});",
              "",
              "pm.test(\"Only one student keeps this email\", () => {",
              "  pm.sendRequest(",
              "    {",
              "      url: `${pm.variables.get(\"baseUrl\")}/students?search=${pm.collectionVariables.get(\"baselineEmail\")}`,",
              "      method: \"GET\",",
              "    },",
              "    (error, response) => {",
              "      pm.expect(error).to.be.null;",
              "      pm.expect(response.json().count).to.eql(1);",
              "    }",
              "  );",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": \"{{baselineStudentId}}-B\",\n  \"name\": \"Duplicate Attempt\",\n  \"email\": \"{{baselineEmail}}\",\n  \"phone\": \"9876500002\",\n  \"department\": \"ECE\",\n  \"year\": 2,\n  \"division\": \"C\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/students",
          "host": ["{{baseUrl}}"],
          "path": ["students"]
        }
      }
    },
    {
      "name": "9. Cleanup Test Data (DELETE)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Baseline student is removed\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Cleanup leaves no test records behind\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.message).to.eql(\"Student deleted successfully\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/students/{{baselineObjectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["students", "{{baselineObjectId}}"]
        }
      }
    }
  ]
}
